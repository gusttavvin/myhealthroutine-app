{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myhealthroutine",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myhealthroutine",
      "database_id": "0a6f1f36-c18b-4810-aefc-7c1ed916b868",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "VAPID_PUBLIC_KEY": "BA4Eqdf9pOasLzjv2N1AILqDxWCpvaKNC3P9peeU5pjEKHx7aDfbU1VuhYnB3BQSjtxnzWf5TtOUrjynmnetHlA",
    "VAPID_SUBJECT": "https://myhealthroutine.myhealthroutine.workers.dev"
  },
  "observability": { "enabled": true }
}
